# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API Keys (Publishable key = sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...), hanya untuk server (jangan pernah diawali NEXT_PUBLIC_). Dipakai untuk tugas admin dan penyiapan Super Admin.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alamat email milik tim untuk uji kirim email Auth (node scripts/auth-email-check.mjs); hanya lokal, jangan dipakai produksi.
AUTH_TEST_EMAIL=

# Gateway QRIS self-hosted PaymentGT (server-only, opsional; bila kosong layar bayar tetap menampilkan contoh).
PAYMENTGT_BASE_URL=
PAYMENTGT_API_TOKEN=
PAYMENTGT_WEBHOOK_SECRET=
PAYMENTGT_CALLBACK_URL=

# Email transaksional via Resend (Fase 5, server-only; jangan pernah diawali NEXT_PUBLIC_).
# Untuk email Auth (verifikasi & reset sandi), isi juga Custom SMTP di Supabase Dashboard memakai API key yang sama.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Catatan Google OAuth (Fase 5): Client ID dan Client Secret dari Google Cloud diisi langsung di
# Supabase Dashboard > Authentication > Sign In / Providers > Google (tidak perlu di .env aplikasi).
