# Normalize line endings to LF in the repo and in working trees (all platforms).
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary

# Video is stored in Git LFS (landing hero, public/landing/hero/).
*.mp4 filter=lfs diff=lfs merge=lfs -text
